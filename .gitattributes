# Normalise line endings so the repository produces no diff noise across platforms.
* text=auto eol=lf

# Binary assets must never be line-ending translated or diffed.
*.png binary
*.pdf binary
*.csv binary

# Notebooks are JSON: keep them diffable and text-normalised.
*.ipynb text eol=lf

# Explicit language signals for GitHub Linguist.
*.py     text diff=python
*.md     text
*.toml   text
*.yml    text
Makefile text